# ==============================================================================
# AirAware AI — Docker Compose Root Environment Template
# ==============================================================================
# Copy this file to `.env` if you want to customize root Docker Compose variables.
#
# CONSUMED BY: docker-compose.yml / Docker Compose orchestrator
# ==============================================================================

# Database configuration for PostgreSQL Compose container
POSTGRES_USER=airaware
POSTGRES_PASSWORD=airaware_dev_password
POSTGRES_DB=airaware_db
POSTGRES_PORT=5432

# Redis cache port
REDIS_PORT=6379

# FastAPI backend port
BACKEND_PORT=8000

# Frontend HTTP port (Nginx reverse proxy)
FRONTEND_PORT=80
FRONTEND_PORT_ALT=3000
