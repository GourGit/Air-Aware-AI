# ==============================================================================
# AirAware AI — Backend Environment Configuration Template
# ==============================================================================
# Copy this file to `backend/.env` before running the FastAPI backend.
#
# CONSUMED BY: FastAPI Backend, Alembic Migration Runner, Celery/Worker
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. DATABASE CONFIGURATION (Required)
# ------------------------------------------------------------------------------
# Format: postgresql+asyncpg://<USER>:<PASSWORD>@<HOST>:<PORT>/<DB_NAME>
#
# For Local Non-Docker Development (PostgreSQL 18 on host):
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/airaware_db
#
# For Docker Compose (PostgreSQL service container):
# DATABASE_URL=postgresql+asyncpg://airaware:airaware_dev_password@postgres:5432/airaware_db

# ------------------------------------------------------------------------------
# 2. CACHE & IN-MEMORY STORE (Optional for local dev, Required for production caching)
# ------------------------------------------------------------------------------
# Format: redis://<HOST>:<PORT>/<DB_INDEX>
# Local Non-Docker default:
REDIS_URL=redis://localhost:6379/0
# Docker Compose default:
# REDIS_URL=redis://redis:6379/0

# ------------------------------------------------------------------------------
# 3. SECURITY & CRYPTOGRAPHY SECRETS
# ------------------------------------------------------------------------------
# REQUIRED in production (must be random, >= 32 characters).
# In development, safe non-production defaults are provided.
SECRET_KEY=dev-airaware-secret-key-32-characters-long
JWT_SECRET_KEY=dev-airaware-jwt-secret-key-32-chars
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7
JWT_ALGORITHM=HS256

# ------------------------------------------------------------------------------
# 4. RUNTIME ENVIRONMENT & LOGGING (Required)
# ------------------------------------------------------------------------------
# Options: development | staging | production | testing
ENVIRONMENT=development
# Options: DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO

# ------------------------------------------------------------------------------
# 5. CORS ORIGINS (Required)
# ------------------------------------------------------------------------------
# Comma-separated list of allowed HTTP/HTTPS origins.
CORS_ORIGINS=http://localhost,http://localhost:80,http://localhost:3000,http://localhost:5173,http://127.0.0.1,http://127.0.0.1:80,http://127.0.0.1:3000,http://127.0.0.1:5173

# ------------------------------------------------------------------------------
# 6. EXTERNAL API KEYS (Optional — fallbacks and CPCB baselines used when omitted)
# ------------------------------------------------------------------------------
# Google Maps JavaScript API (for interactive pollution map)
GOOGLE_MAPS_API_KEY=
# OpenAQ API (for global / international monitoring station enrichment)
OPENAQ_API_KEY=

# ------------------------------------------------------------------------------
# 7. AI & LLM PROVIDER CONFIGURATION (Optional for core AQI, Required for AI Chat)
# ------------------------------------------------------------------------------
# Options: openai | openrouter | mock
LLM_PROVIDER=openai
LLM_API_KEY=
LLM_MODEL=gpt-4o

# ------------------------------------------------------------------------------
# 8. SERVICE URLS (Informational & Link Generation)
# ------------------------------------------------------------------------------
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:8000
