# ===========================================
# AirAware AI - Environment Configuration
# ===========================================

# Database (PostgreSQL 18 default, adjust user/password to match your local setup)
# For local PostgreSQL 18:
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/airaware_db
# For Docker Compose:
# DATABASE_URL=postgresql+asyncpg://airaware:airaware_dev_password@localhost:5432/airaware_db

# Redis
REDIS_URL=redis://localhost:6379/0

# Application Security Secrets
SECRET_KEY=dev-airaware-secret-key-32-characters-long
JWT_SECRET_KEY=dev-airaware-jwt-secret-key-32-chars
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# LLM / AI Configuration (OpenRouter / OpenAI compatible)
LLM_PROVIDER=openai
LLM_API_KEY=
LLM_MODEL=gpt-4o

# External APIs (Optional for live satellite/global station enrichment)
OPENAQ_API_KEY=
GOOGLE_MAPS_API_KEY=

# Application URLs & CORS
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:8000
ENVIRONMENT=development
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:5173
