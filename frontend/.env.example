# ==============================================================================
# AirAware AI — Frontend Environment Configuration Template
# ==============================================================================
# Copy this file to `frontend/.env` before running the Vite React application.
#
# CONSUMED BY: Vite Client Bundler (Product A — Public AQI Website)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. API BACKEND URL (Required)
# ------------------------------------------------------------------------------
# Local Non-Docker Development (Vite running on host):
VITE_API_URL=http://localhost:8000/api/v1
#
# Docker Compose Nginx Production Build (relative path proxied by Nginx):
# VITE_API_URL=/api/v1

# ------------------------------------------------------------------------------
# 2. GOOGLE MAPS API KEY (Optional)
# ------------------------------------------------------------------------------
# If omitted or invalid, AirAware AI automatically falls back to an interactive
# Indian Coordinate Canvas map without breaking navigation or layout.
VITE_GOOGLE_MAPS_API_KEY=

# ------------------------------------------------------------------------------
# 3. GOOGLE MAPS MAP ID (Optional)
# ------------------------------------------------------------------------------
# Required only if using Advanced Markers with custom Google Cloud Vector styling.
VITE_GOOGLE_MAPS_MAP_ID=
